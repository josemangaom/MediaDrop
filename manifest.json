{
  "manifest_version": 3,
  "name": "MediaDrop",
  "version": "1.0.16",
  "description": "Detecta imágenes, SVG y videos, filtra falsos positivos y captura reproductores MSE/streaming compatibles sin pestañas auxiliares.",
  "permissions": [
    "downloads",
    "storage",
    "webRequest",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "backend/controllers/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir MediaDrop",
    "default_icon": {
      "16": "frontend/public/icons/icon16.png",
      "24": "frontend/public/icons/icon24.png",
      "32": "frontend/public/icons/icon32.png",
      "48": "frontend/public/icons/icon48.png"
    },
    "default_popup": "frontend/src/pages/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "frontend/src/services/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "frontend/public/icons/icon16.png",
    "32": "frontend/public/icons/icon32.png",
    "48": "frontend/public/icons/icon48.png",
    "128": "frontend/public/icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; connect-src http: https:; media-src 'self' blob: http: https:; img-src 'self' data: http: https:;"
  }
}
